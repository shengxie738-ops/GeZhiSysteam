<view class="tab-bar-container">
  <view class="tab-bar">
    <view 
      class="tab-item {{selected === index ? 'active' : ''}}" 
      wx:for="{{list}}" 
      wx:key="index" 
      data-path="{{item.pagePath}}" 
      data-index="{{index}}" 
      bindtap="switchTab"
    >
      <view class="pill-bg">
        <text class="tab-icon">{{item.icon}}</text>
        <text class="tab-text">{{item.text}}</text>
      </view>
    </view>
  </view>
</view>
