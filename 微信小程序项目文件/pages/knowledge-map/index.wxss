/* pages/knowledge-map/index.wxss */

.page-container {
  padding: var(--space-4);
  padding-bottom: 120rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* Loading */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--color-border);
  border-top-color: var(--color-seal);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: var(--space-3);
  font-size: var(--font-caption);
  color: var(--color-ash);
}

/* Error */
.error-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

/* Tree */
.tree-list {
  display: flex;
  flex-direction: column;
}

.tree-node {
  background-color: var(--color-card);
  border-radius: var(--radius-md);
  padding: var(--space-3);
  margin-bottom: var(--space-1);
  border: 1rpx solid var(--color-border-light);
  box-shadow: var(--shadow-card);
}

.tree-node-root {
  border-left: 6rpx solid var(--color-indigo);
}

.tree-node-l1 {
  margin-left: 40rpx;
  border-left: 6rpx solid var(--color-border);
}

.tree-node-l2 {
  margin-left: 80rpx;
  border-left: 6rpx solid var(--color-border-light);
}

.node-seal {
  border-left-color: var(--color-seal) !important;
  background-color: var(--color-seal-bg);
}

.node-bamboo {
  border-left-color: var(--color-bamboo) !important;
}

/* Node layout */
.node-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.node-toggle {
  font-size: var(--font-body);
  color: var(--color-ash);
  width: 32rpx;
  text-align: center;
  flex-shrink: 0;
}

.node-leaf {
  color: var(--color-ash-light);
}

.node-name {
  font-size: var(--font-card-title);
  color: var(--color-ink);
  font-weight: 500;
  flex: 1;
}

.node-name-root {
  font-size: var(--font-section-title);
  font-weight: 600;
}

/* Mastery bar */
.node-bar-wrap {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-top: var(--space-2);
  padding-left: 48rpx;
}

.node-bar-bg {
  flex: 1;
  height: 10rpx;
  background-color: var(--color-border-light);
  border-radius: var(--radius-pill);
  overflow: hidden;
}

.node-bar-fill {
  height: 100%;
  border-radius: var(--radius-pill);
  transition: width 0.3s ease;
}

.node-bar-low {
  background-color: var(--color-seal);
}

.node-bar-ok {
  background-color: var(--color-bamboo);
}

.node-bar-val {
  font-size: var(--font-micro);
  color: var(--color-ash);
  min-width: 60rpx;
  text-align: right;
}

/* Actions */
.node-actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-top: var(--space-2);
  padding-left: 48rpx;
}

/* Bottom link */
.bottom-link {
  margin-top: var(--space-4);
  text-align: center;
  padding: var(--space-3) 0;
}

.bottom-link-text {
  font-size: var(--font-body);
  color: var(--color-seal);
  font-weight: 500;
}
